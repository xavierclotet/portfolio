---
import BaseLayout from '../layouts/BaseLayout.astro';
import Arrow from '../components/Arrow.astro';
import { UI } from '../i18n/ui.ts';

// Astro sirve una sola 404 para todas las rutas: se muestra en los dos idiomas.
const es = UI.es;
const en = UI.en;
---

<BaseLayout lang="es" title={`${es['notfound.title']} / ${en['notfound.title']}`}>
  <section class="out">
    <div class="cut" aria-hidden="true"><span></span><span></span></div>
    <h1>{es['notfound.title']}</h1>
    <p class="lead">{es['notfound.lead']}</p>
    <p><a class="back" href="/"><Arrow back /> {es['notfound.back']}</a></p>

    <div lang="en" class="other">
      <h2>{en['notfound.title']}</h2>
      <p class="lead">{en['notfound.lead']}</p>
      <p><a class="back" href="/en/"><Arrow back /> {en['notfound.back']}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Tramo cortado: la línea se interrumpe donde debería estar la estación. */
  .cut {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    margin-bottom: var(--space-8);
  }

  .cut span {
    height: var(--track);
    border-radius: var(--track);
    background: var(--ink);
  }

  .cut span:first-child {
    width: 8rem;
  }

  .cut span:last-child {
    width: 3rem;
    background: repeating-linear-gradient(90deg, var(--ink) 0 0.75rem, transparent 0.75rem 1.25rem);
  }

  h1 {
    margin: 0 0 var(--space-4);
    font-size: clamp(2.25rem, 8vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  h2 {
    margin: 0 0 var(--space-3);
    font-size: clamp(1.5rem, 5vw, 2rem);
  }

  .lead {
    margin: 0 0 var(--space-6);
    font-size: 1.1875rem;
    color: var(--ink-2);
  }

  .other {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 2px solid var(--ink);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    font-weight: 700;
  }
</style>
