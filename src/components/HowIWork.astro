---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { howIWorkPath, otherLang, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = await getEntry('pages', `${lang}/como-trabajo`);
if (!page) throw new Error(`Falta src/content/pages/${lang}/como-trabajo.md`);
const { Content } = await render(page);
---

<BaseLayout lang={lang} title={page.data.title} description={page.data.summary} altPath={howIWorkPath(otherLang(lang))} current="howiwork">
  <article>
    <header class="head">
      <h1>{page.data.title}</h1>
      <p class="lead">{page.data.summary}</p>
    </header>
    <div class="route prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-12);
    border-bottom: var(--track) solid var(--ink);
  }

  h1 {
    margin: 0 0 var(--space-4);
    font-size: clamp(2.25rem, 8vw, 3.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .lead {
    margin: 0;
    font-size: 1.1875rem;
    color: var(--ink-2);
    max-width: 38rem;
  }

  /* El párrafo de entrada va antes de la primera estación. */
  .route :global(> p:first-child) {
    margin-top: 0;
    font-size: 1.125rem;
  }
</style>
