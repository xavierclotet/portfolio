---
interface Props {
  /** Hacia atrás (vuelta al inicio o a la lista). */
  back?: boolean;
}

const { back = false } = Astro.props;
---

<svg class:list={['arrow', { back }]} viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
  <path d="M3 10h13M11 4.5 16.5 10 11 15.5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" />
</svg>

<style>
  .arrow {
    flex: none;
    width: 1.1em;
    height: 1.1em;
    vertical-align: -0.15em;
  }

  .back {
    transform: scaleX(-1);
  }
</style>
