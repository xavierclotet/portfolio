---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from './ProjectCard.astro';
import { SITE } from '../config/site.ts';
import { PROJECTS_SEGMENT, t, type Lang } from '../i18n/ui.ts';
import { getProjects } from '../lib/projects.ts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);
const projects = await getProjects(lang);
const contacts = [
  { label: 'GitHub', href: SITE.github },
  { label: 'LinkedIn', href: SITE.linkedin },
  { label: SITE.email, href: SITE.email && `mailto:${SITE.email}` },
].filter((c) => c.href);
---

<BaseLayout lang={lang}>
  <section class="hero">
    <h1>{tr('hero.title')}</h1>
    <p class="lead muted">{tr('hero.lead')}</p>
  </section>

  <section id={PROJECTS_SEGMENT[lang]} aria-labelledby="projects-title">
    <h2 id="projects-title">{tr('projects.title')}</h2>
    <p class="muted">{tr('projects.lead')}</p>
    <div class="grid">
      {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">{tr('contact.title')}</h2>
    <p class="muted">{tr('contact.lead')}</p>
    <ul class="contacts">
      {contacts.map((c) => <li><a href={c.href} rel="me">{c.label}</a></li>)}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero h1 {
    margin: 0 0 var(--space-4);
    font-size: clamp(1.75rem, 6vw, 2.75rem);
  }

  .lead {
    margin: 0;
    font-size: 1.125rem;
    max-width: 38rem;
  }

  section + section {
    margin-top: var(--space-12);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contacts a {
    display: inline-block;
    min-height: 2.75rem;
    line-height: 2.75rem;
  }
</style>
